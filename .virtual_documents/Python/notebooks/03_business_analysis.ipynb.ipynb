import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")


import sys
sys.path.append("../scripts")

from data_loader import load_data


orders, order_items, products, refunds = load_data("../../data/raw")


# import pandas as pd

# orders = pd.read_csv(r"../../data/raw/orders.csv")
# order_items = pd.read_csv(r"../../data/raw/order_items.csv")
# products = pd.read_csv(r"../../data/raw/products.csv")
# refunds = pd.read_csv(r"../../data/raw/order_item_refunds.csv")


orders["created_at"] = pd.to_datetime(
    orders["created_at"]
)

order_items["created_at"] = pd.to_datetime(
    order_items["created_at"]
)

order_summary = (
    order_items
    .groupby("order_id")
    .agg(
        total_items=("order_item_id", "count"),
        revenue=("price_usd", "sum"),
        cogs=("cogs_usd", "sum")
    )
    .reset_index()
)

order_summary["profit"] = (
    order_summary["revenue"]
    - order_summary["cogs"]
)

order_summary["profit_margin"] = np.where(
    order_summary["revenue"] != 0,
    (order_summary["profit"]
     / order_summary["revenue"]) * 100,
    0
)

orders_analysis = orders.merge(
    order_summary,
    on="order_id",
    how="left"
)


total_orders = orders_analysis["order_id"].nunique()

total_customers = orders_analysis["user_id"].nunique()

total_items = orders_analysis["total_items"].sum()

total_revenue = orders_analysis["revenue"].sum()

total_cogs = orders_analysis["cogs"].sum()

total_profit = orders_analysis["profit"].sum()

average_order_value = (
    total_revenue / total_orders
)

overall_profit_margin = (
    total_profit / total_revenue
) * 100


kpis = pd.DataFrame({
    "Metric": [
        "Total Orders",
        "Total Customers",
        "Total Items",
        "Total Revenue",
        "Total COGS",
        "Total Profit",
        "Average Order Value",
        "Overall Profit Margin"
    ],
    "Value": [
        total_orders,
        total_customers,
        total_items,
        total_revenue,
        total_cogs,
        total_profit,
        average_order_value,
        overall_profit_margin
    ]
})

display(kpis)


orders_analysis["created_at"] = pd.to_datetime(
    orders_analysis["created_at"]
)

monthly_sales = (
    orders_analysis
    .set_index("created_at")
    .resample("ME")
    .agg(
        revenue=("revenue", "sum"),
        profit=("profit", "sum"),
        orders=("order_id", "nunique")
    )
    .reset_index()
)

display(monthly_sales.head())


plt.figure(figsize=(12, 6))

plt.plot(
    monthly_sales["created_at"],
    monthly_sales["revenue"],
    marker="o"
)

plt.title("Monthly Revenue Trend")
plt.xlabel("Month")
plt.ylabel("Revenue")

plt.xticks(rotation=45)

plt.tight_layout()

plt.savefig(
    "../visualizations/monthly_revenue.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


plt.figure(figsize=(12, 6))

plt.plot(
    monthly_sales["created_at"],
    monthly_sales["profit"],
    marker="o"
)

plt.title("Monthly Profit Trend")
plt.xlabel("Month")
plt.ylabel("Profit")

plt.xticks(rotation=45)

plt.tight_layout()

plt.savefig(
    "../visualizations/monthly_profit.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


product_sales = order_items.merge(
    products,
    on="product_id",
    how="left"
)


product_sales["revenue"] = (
    product_sales["price_usd"]
)

product_sales["profit"] = (
    product_sales["price_usd"]
    - product_sales["cogs_usd"]
)


product_summary = (
    product_sales
    .groupby(
        ["product_id", "product_name"]
    )
    .agg(
        units_sold=("order_item_id", "count"),
        revenue=("revenue", "sum"),
        cogs=("cogs_usd", "sum"),
        profit=("profit", "sum")
    )
    .reset_index()
)


product_summary["profit_margin"] = np.where(
    product_summary["revenue"] != 0,
    (
        product_summary["profit"]
        / product_summary["revenue"]
    ) * 100,
    0
)


top_revenue_products = (
    product_summary
    .sort_values(
        "revenue",
        ascending=False
    )
    .head(10)
)

display(top_revenue_products)


plt.figure(figsize=(10, 6))

sns.barplot(
    data=top_revenue_products,
    x="revenue",
    y="product_name"
)

plt.title("Top 10 Products by Revenue")
plt.xlabel("Revenue")
plt.ylabel("Product")

plt.tight_layout()

plt.savefig(
    "../visualizations/top_products_revenue.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


plt.figure(figsize=(10, 6))

sns.scatterplot(
    data=product_summary,
    x="revenue",
    y="profit",
    size="units_sold",
    legend=False
)

plt.title("Product Revenue vs Profit")
plt.xlabel("Revenue")
plt.ylabel("Profit")

plt.tight_layout()

plt.savefig(
    "../visualizations/product_revenue_vs_profit.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


customer_analysis = (
    orders_analysis
    .groupby("user_id")
    .agg(
        total_orders=("order_id", "nunique"),
        total_items=("total_items", "sum"),
        total_revenue=("revenue", "sum"),
        total_profit=("profit", "sum")
    )
    .reset_index()
)


customer_analysis["customer_type"] = np.where(
    customer_analysis["total_orders"] == 1,
    "One-time",
    "Repeat"
)


customer_type_count = (
    customer_analysis["customer_type"]
    .value_counts()
)

display(customer_type_count)


customer_type_revenue = (
    customer_analysis
    .groupby("customer_type")
    ["total_revenue"]
    .sum()
    .reset_index()
)

display(customer_type_revenue)


plt.figure(figsize=(8, 5))

sns.barplot(
    data=customer_type_revenue,
    x="customer_type",
    y="total_revenue"
)

plt.title("Revenue by Customer Type")
plt.xlabel("Customer Type")
plt.ylabel("Revenue")

plt.tight_layout()

plt.savefig(
    "../visualizations/customer_type_revenue.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


top_customers = (
    customer_analysis
    .sort_values(
        "total_revenue",
        ascending=False
    )
    .head(10)
)

display(top_customers)


refund_analysis = refunds.merge(
    order_items[
        [
            "order_item_id",
            "product_id"
        ]
    ],
    on="order_item_id",
    how="left"
)


refund_analysis = refund_analysis.merge(
    products[
        [
            "product_id",
            "product_name"
        ]
    ],
    on="product_id",
    how="left"
)


total_refunds = len(refunds)

total_refund_amount = (
    refunds["refund_amount_usd"].sum()
)

refunded_orders = (
    refunds["order_id"].nunique()
)

refund_rate = (
    refunded_orders
    / total_orders
) * 100


refund_kpis = pd.DataFrame({
    "Metric": [
        "Total Refund Records",
        "Total Refund Amount",
        "Refunded Orders",
        "Refund Rate (%)"
    ],
    "Value": [
        total_refunds,
        total_refund_amount,
        refunded_orders,
        refund_rate
    ]
})

display(refund_kpis)


product_refunds = (
    refund_analysis
    .groupby("product_name")
    .agg(
        refund_count=(
            "order_item_refund_id",
            "count"
        ),
        refund_amount=(
            "refund_amount_usd",
            "sum"
        )
    )
    .reset_index()
    .sort_values(
        "refund_amount",
        ascending=False
    )
)


display(
    product_refunds.head(10)
)


top_refund_products = (
    product_refunds.head(10)
)

plt.figure(figsize=(10, 6))

sns.barplot(
    data=top_refund_products,
    x="refund_amount",
    y="product_name"
)

plt.title("Top Products by Refund Amount")
plt.xlabel("Refund Amount")
plt.ylabel("Product")

plt.tight_layout()

plt.savefig(
    "../visualizations/top_refund_products.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


product_summary["performance"] = np.select(
    [
        (
            (product_summary["revenue"] >=
             product_summary["revenue"].median())
            &
            (product_summary["profit"] >=
             product_summary["profit"].median())
        ),
        (
            (product_summary["revenue"] >=
             product_summary["revenue"].median())
            &
            (product_summary["profit"] <
             product_summary["profit"].median())
        )
    ],
    [
        "High Revenue - High Profit",
        "High Revenue - Low Profit"
    ],
    default="Other"
)


display(
    product_summary[
        [
            "product_name",
            "revenue",
            "profit",
            "profit_margin",
            "performance"
        ]
    ].sort_values(
        "revenue",
        ascending=False
    )
)



